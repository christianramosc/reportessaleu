# Copia este archivo como .streamlit/secrets.toml (local) o pega el contenido
# en Settings → Secrets de Streamlit Community Cloud.
APP_PASSWORD = "cambia-esta-clave"

# ---- Base de seguimiento en Google Sheets (opcional; sin esto la app trabaja en "modo Excel")
# Enlace del Google Sheet "Seguimiento Rechazos MG Colima" (compártelo como EDITOR con client_email)
SEGUIMIENTO_SHEET_URL = "https://docs.google.com/spreadsheets/d/XXXXXXXXXXXX/edit"
# Enlace de la bitácora de F&I "Financiamiento" (compártela como LECTOR con client_email). Opcional.
FINANCIAMIENTO_SHEET_URL = "https://docs.google.com/spreadsheets/d/YYYYYYYYYYYY/edit"

# Contenido del archivo JSON de la cuenta de servicio (Google Cloud → IAM → Cuentas de servicio → Claves)
[gcp_service_account]
type = "service_account"
project_id = "tu-proyecto"
private_key_id = "…"
private_key = "-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----\n"
client_email = "cuadres-mg@tu-proyecto.iam.gserviceaccount.com"
client_id = "…"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "…"
universe_domain = "googleapis.com"
